/* wap to create rectengal class with veriable length and breath
 calculate area and parameter using function */
 #include<iostream.h>
 #include<conio.h>
 #include<string.h>

class rectengle

{
	public:
	int l,b;

	void getdata()
	{
	    cout<<"\n Enter length & breadth";
	    cin>>l>>b;
	}

	int area()
	{
	   return l*b;
	}

	int perimeter()
	{
	   return 2*(l+b);
	}
};
void main()

{

  rectengle obj1;
  int a,p;
  clrscr();
  obj1.getdata();

  a=obj1.area();
  cout<<"\n area of rec\n"<<a;

  p=obj1.perimeter();
  cout<<"\n perimeter of rect\n"<<p;

getch();

}















