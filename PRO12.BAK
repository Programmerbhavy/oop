/* wap to create a class book with data member bid,bname,pname,aname,pages
with member function getdata and if one pages with member function getdata
and if one page of a book is of 20 rupee display
all details with total cost of book */

#include<iostream.h>
#include<conio.h>

class book
{
public:
int bid,pages;
char *bname,*pname,*aname;

void getdata()
{
 cout<<"\n Enter bid,bname,pname,aname and page";
 cin>>bid>>bname>>pname>>aname>>pages;
}
void display()
{
 int price=0;
 price = pages*20;
 cout<<"\n bid"<<bid;
 cout<<"\n bname"<<bname;
 cout<<"\n publisher"<<pname;
 cout<<"\n author"<<aname;
 cout<<"\n price"<<price;

}
};

void main()
{
 book b1;
 clrscr();
 b1.getdata();
 b1.display();
 getch();
}
